{
  "manifest_version": 3,
  "name": "Cua Driver",
  "version": "0.1.0",
  "description": "Lets the Cua Driver on this Mac read and act on your Chrome tabs when you ask it to.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cua Driver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "alarms",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
